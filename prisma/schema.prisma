generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AdminStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum AdminVerificationDocumentType {
  DEGREE
  GAZETTE_NOTIFICATION
  AUTHORIZATION_LETTER
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum AppointmentStatus {
  PENDING
  APPROVED
  RESCHEDULED
  REJECTED
}

enum DeadlineType {
  ASSIGNMENT
  QUIZ
  EXAM
}

enum NotificationType {
  ANNOUNCEMENT
  APPOINTMENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

model User {
  id                   String             @id @default(cuid())
  name                 String
  email                String             @unique
  passwordHash         String
  role                 UserRole
  status               UserStatus         @default(APPROVED)
  adminStatus          AdminStatus        @default(NONE)
  adminDocuments       String[]           @default([])
  department           String?
  semester             Int?
  rollNo               String?            @unique
  fatherName           String?
  surname              String?
  category             String?
  academicYear         String?
  validUpto            String?
  phone                String?
  bloodGroup           String?
  emergencyContact     String?
  linkedinUrl          String?
  githubUrl             String?
  emailVerifiedAt      DateTime?
  image                String?            @db.Text
  createdAt            DateTime           @default(now())
  emailVerificationCode EmailVerificationCode?
  courses              Course[]           @relation("CourseTeacher")
  timetableSlots       TimetableSlot[]    @relation("TimetableTeacher")
  coTeachingSlots      TimetableSlot[]    @relation("TimetableSlotTeachers")
  availabilitySlots    AvailabilitySlot[] @relation("TeacherAvailability")
  studentAppointments  Appointment[]      @relation("AppointmentStudent")
  teacherAppointments  Appointment[]      @relation("AppointmentTeacher")
  enrollments          Enrollment[]       @relation("EnrollmentStudent")
  announcementsCreated Announcement[]     @relation("AnnouncementCreator")
  passwordResetTokens PasswordResetToken[]
  notifications        Notification[]
  studentAttendance    Attendance[]       @relation("AttendanceStudent")
  attendanceMarked     Attendance[]       @relation("AttendanceMarker")
  adminVerificationDocuments AdminVerificationDocument[]

  @@index([role])
  @@index([adminStatus])
}

model AdminVerificationDocument {
  id           String                        @id
  userId       String
  documentType AdminVerificationDocumentType
  filename     String
  mimeType     String
  content      Bytes                         @db.ByteA
  createdAt    DateTime                      @default(now())
  user         User                          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, documentType])
  @@index([userId])
}

model EmailVerificationCode {
  id        String   @id @default(cuid())
  userId    String   @unique
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  sentAt    DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Course {
  id             String          @id @default(cuid())
  code           String          @unique
  name           String
  teacherId      String
  teacher        User            @relation("CourseTeacher", fields: [teacherId], references: [id])
  timetableSlots TimetableSlot[]
  deadlines      Deadline[]

  @@index([teacherId])
}

model Section {
  id             String          @id @default(cuid())
  name           String
  department     String
  semester       Int
  enrollments    Enrollment[]
  timetableSlots TimetableSlot[]
  attendance     Attendance[]

  @@index([department, semester])
}

model Enrollment {
  id        String  @id @default(cuid())
  studentId String
  sectionId String
  student   User    @relation("EnrollmentStudent", fields: [studentId], references: [id], onDelete: Cascade)
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([studentId, sectionId])
  @@index([sectionId])
}

model Room {
  id             String          @id @default(cuid())
  name           String          @unique
  capacity       Int
  timetableSlots TimetableSlot[]
}

model TimetableSlot {
  id        String    @id @default(cuid())
  courseId  String
  sectionId String
  roomId    String
  teacherId String
  dayOfWeek DayOfWeek
  startTime DateTime  @db.Time(0)
  endTime   DateTime  @db.Time(0)
  course    Course    @relation(fields: [courseId], references: [id])
  section   Section   @relation(fields: [sectionId], references: [id])
  room      Room      @relation(fields: [roomId], references: [id])
  teacher   User      @relation("TimetableTeacher", fields: [teacherId], references: [id])
  teachers  User[]    @relation("TimetableSlotTeachers")
  attendance Attendance[]

  @@index([roomId, dayOfWeek, startTime])
  @@index([teacherId, dayOfWeek, startTime])
  @@index([sectionId, dayOfWeek, startTime])
  @@index([dayOfWeek])
}

model AvailabilitySlot {
  id        String    @id @default(cuid())
  teacherId String
  dayOfWeek DayOfWeek
  startTime DateTime  @db.Time(0)
  endTime   DateTime  @db.Time(0)
  teacher   User      @relation("TeacherAvailability", fields: [teacherId], references: [id])

  @@index([teacherId, dayOfWeek, startTime])
}

model Appointment {
  id        String            @id @default(cuid())
  studentId String
  teacherId String
  date      DateTime          @db.Date
  startTime DateTime          @db.Time(0)
  endTime   DateTime          @db.Time(0)
  status    AppointmentStatus @default(PENDING)
  note      String?
  student   User              @relation("AppointmentStudent", fields: [studentId], references: [id])
  teacher   User              @relation("AppointmentTeacher", fields: [teacherId], references: [id])

  @@index([studentId, date])
  @@index([teacherId, date, startTime])
}

model Deadline {
  id       String       @id @default(cuid())
  courseId String
  title    String
  type     DeadlineType
  dueDate  DateTime     @db.Date
  course   Course       @relation(fields: [courseId], references: [id])

  @@index([courseId, dueDate])
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  message     String
  department  String?
  semester    Int?
  createdById String
  createdAt   DateTime @default(now())
  createdBy   User     @relation("AnnouncementCreator", fields: [createdById], references: [id])

  @@index([department, semester, createdAt])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt])
}

model Attendance {
  id              String           @id @default(cuid())
  studentId       String
  sectionId       String
  timetableSlotId String
  courseCode      String
  date            DateTime         @db.Date
  status          AttendanceStatus
  markedBy        String
  createdAt       DateTime         @default(now())
  student         User             @relation("AttendanceStudent", fields: [studentId], references: [id], onDelete: Cascade)
  teacher         User             @relation("AttendanceMarker", fields: [markedBy], references: [id], onDelete: Restrict)
  section         Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  timetableSlot   TimetableSlot    @relation(fields: [timetableSlotId], references: [id], onDelete: Cascade)

  @@unique([studentId, timetableSlotId, date])
  @@index([studentId, date])
  @@index([timetableSlotId, date])
  @@index([markedBy, date])
}
